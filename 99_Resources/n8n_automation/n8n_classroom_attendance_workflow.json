    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.responseUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"response_type\": \"ephemeral\",\n  \"replace_original\": false,\n  \"text\": \"✅ *Attendance Confirmed!*\\nHello {{ $json.studentName }}, your attendance has been recorded as *PRESENT* for today ({{ $json.todayDateStr }}).\"\n}",
        "options": {}
