      "typeVersion": 1.2,
      "position": [200, 200]
    },
    {
      "parameters": {
        "channel": "C0C0U2PJ43A",
        "text": "📢 Good morning class! Attendance check-in is now active for Cryptography & Data Protection.",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "🔐 Cryptography & Data Protection - Daily Attendance"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "👋 Good morning! Please click the button below to mark your attendance for today's session.\n• *Channel*: `#board-infinity`\n• *Window*: Active for 15 minutes"
              }
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "🟢 Check In for Today"
                  },
                  "style": "primary",
                  "action_id": "crypto_attendance_checkin",
                  "value": "checkin_clicked"
                }
              ]
            },
            {
              "type": "context",
              "elements": [
                {
                  "type": "mrkdwn",
                  "text": "📌 Attendance syncs automatically to your official university register in Google Sheets."
                }
              ]
            }
          ]
        },
        "otherOptions": {}
      },
      "id": "slack-post-checkin-prompt",
      "name": "Post Check-in Card to #board-infinity",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [440, 200],
      "credentials": {
        "slackApi": {
          "id": "s3AqEZsbgUkota6O",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-attendance-checkin",
        "options": {}
      },
      "id": "webhook-slack-interaction",
      "name": "Slack Interactivity Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 480],
      "webhookId": "crypto-attendance-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse incoming payload from Slack Block Kit button click\nlet payload = $input.first().json;\n\nif (payload.body && typeof payload.body.payload === 'string') {\n  payload = JSON.parse(payload.body.payload);\n} else if (typeof payload.payload === 'string') {\n  payload = JSON.parse(payload.payload);\n}\n\nconst user = payload.user || {};\nconst userId = user.id || '';\nconst userName = user.name || user.username || 'Student';\nconst channelId = (payload.channel && payload.channel.id) ? payload.channel.id : 'C0C0U2PJ43A';\nconst responseUrl = payload.response_url || '';\n\nconst now = new Date();\nconst day = String(now.getDate()).padStart(2, '0');\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst year = now.getFullYear();\nconst todayDateStr = `${day}-${month}-${year}`;\n\nreturn [{\n  json: {\n    userId,\n    userName,\n    channelId,\n    responseUrl,\n    todayDateStr,\n    timestamp: now.toISOString()\n  }\n}];"
      },
      "id": "parse-slack-payload",
      "name": "Parse Slack Payload & Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 480]
    },
    {
      "parameters": {
        "operation": "get",
        "user": "={{ $json.userId }}"
      },
      "id": "get-slack-user-profile",
      "name": "Get Student University Email",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [660, 480],
      "credentials": {
        "slackApi": {
          "id": "s3AqEZsbgUkota6O",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://script.google.com/macros/s/AKfycbxyjzGoMgkJjpxu9ay8OgxnGPeazM7IUuS37nS31S1RmDoR6C6H7rw0sGRokaU5oh_3/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $json.profile.email || $json.email }}\",\n  \"user_name\": \"{{ $json.profile.real_name || $json.userName }}\",\n  \"channel_id\": \"C0C0U2PJ43A\",\n  \"channel_name\": \"board-infinity\",\n  \"timestamp\": \"{{ $('Parse Slack Payload & Date').first().json.timestamp }}\"\n}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "http-to-apps-script",
      "name": "Send to Google Sheet Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parse Slack Payload & Date').first().json.responseUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"response_type\": \"ephemeral\",\n  \"replace_original\": false,\n  \"text\": \"{{ $json.message || '✅ Attendance marked PRESENT in your class Google Sheet!' }}\"\n}",
        "options": {}
      },
      "id": "send-slack-confirmation",
      "name": "Send Ephemeral Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 480]
    }
  ],
